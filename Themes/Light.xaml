<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 白天模式配色；键名须与 Dark.xaml 一一对应 -->
    <SolidColorBrush x:Key="PageBrush" Color="#F3F5F8" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E6EC" />
    <SolidColorBrush x:Key="TextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="MutedBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#A0BDF5" />
    <SolidColorBrush x:Key="ControlBorderBrush" Color="#D0D5DD" />
    <SolidColorBrush x:Key="ControlBorderHoverBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#E5E7EB" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#FCA5A5" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#FEF2F2" />
    <SolidColorBrush x:Key="SelectBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F3F6FB" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C9CED6" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#9CA3AF" />

    <!-- 执行日志 -->
    <SolidColorBrush x:Key="LogBgBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="LogBorderBrush" Color="#E2E6EC" />
    <SolidColorBrush x:Key="LogTextBrush" Color="#374151" />
    <SolidColorBrush x:Key="LogTimeBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="LogSelectBrush" Color="#DBEAFE" />
    <SolidColorBrush x:Key="LogErrorBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="LogWarningBrush" Color="#B45309" />
    <SolidColorBrush x:Key="LogSuccessBrush" Color="#15803D" />

    <!-- 系统默认模板里用到的颜色（如滚动区右下角的方块） -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#F3F5F8" />
</ResourceDictionary>
