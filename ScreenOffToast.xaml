<Window x:Class="AntoCopy.ScreenOffToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="即将息屏"
        Width="300" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" Cursor="Hand"
        TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource AccentBrush}">
        <StackPanel>
            <TextBlock Text="WiFi 已断开，即将息屏" Style="{StaticResource CardTitle}" />
            <TextBlock x:Name="CountdownText" Margin="0,6,0,0" />
            <TextBlock Text="点击此提示取消本次息屏" Style="{StaticResource Hint}" Margin="0,4,0,0" />
        </StackPanel>
    </Border>
</Window>
