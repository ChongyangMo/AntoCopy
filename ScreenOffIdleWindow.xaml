<Window x:Class="AntoCopy.ScreenOffIdleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="息屏前空闲时间"
        Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="14">
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="WiFi 断开后，键鼠空闲满" VerticalAlignment="Center" />
                    <TextBox x:Name="SecondsInput" Width="70" Margin="6,0" />
                    <TextBlock Text="秒后倒计时息屏" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="0 = 确认断开后立即开始倒计时；倒计时期间点击右下角提示可取消" Style="{StaticResource Hint}" Margin="0,4,0,2" />
            </StackPanel>
        </Border>

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0" />
        </DockPanel>
    </StackPanel>
</Window>
