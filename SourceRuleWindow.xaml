<Window x:Class="AntoCopy.SourceRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="备份频率"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource PageBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="14">
        <TextBlock x:Name="PathText" Style="{StaticResource Hint}" Margin="2,0,2,10" />

        <!-- 定时模式 -->
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="定时模式" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <RadioButton x:Name="ScheduledGlobalRadio" GroupName="Scheduled" Margin="0,5" />
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <RadioButton x:Name="ScheduledCustomRadio" GroupName="Scheduled" Content="自定义：每" />
                    <TextBox x:Name="EveryDaysInput" Width="44" Margin="6,0"
                             IsEnabled="{Binding IsChecked, ElementName=ScheduledCustomRadio}" />
                    <TextBlock Text="天，在" VerticalAlignment="Center" />
                    <TextBox x:Name="TimesInput" Width="170" Margin="6,0" Tag="02:00, 14:00"
                             IsEnabled="{Binding IsChecked, ElementName=ScheduledCustomRadio}" />
                    <TextBlock Text="执行" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="多个时间用逗号分隔：02:00, 14:00 即一天两次；“每 2 天”即隔天执行" Style="{StaticResource Hint}" Margin="22,0,0,2" />
                <RadioButton x:Name="ScheduledOffRadio" GroupName="Scheduled" Content="不参与定时备份" Margin="0,5" />
            </StackPanel>
        </Border>

        <!-- 倒计时模式 -->
        <Border Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="倒计时模式" Style="{StaticResource CardTitle}" Margin="0,0,0,6" />
                <RadioButton x:Name="CountdownGlobalRadio" GroupName="Countdown" Margin="0,5" />
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <RadioButton x:Name="CountdownCustomRadio" GroupName="Countdown" Content="自定义：每" />
                    <TextBox x:Name="CountdownHoursInput" Width="56" Margin="6,0"
                             IsEnabled="{Binding IsChecked, ElementName=CountdownCustomRadio}" />
                    <TextBlock Text="小时" VerticalAlignment="Center" />
                    <TextBox x:Name="CountdownMinutesInput" Width="44" Margin="6,0"
                             IsEnabled="{Binding IsChecked, ElementName=CountdownCustomRadio}" />
                    <TextBlock Text="分钟" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Text="倒计时模式启动后，该文件夹按自己的间隔单独计时、单独打包" Style="{StaticResource Hint}" Margin="22,0,0,2" />
                <RadioButton x:Name="CountdownOffRadio" GroupName="Countdown" Content="不参与倒计时备份" Margin="0,5" />
            </StackPanel>
        </Border>

        <DockPanel Margin="0,12,0,0" LastChildFill="False">
            <Button x:Name="ResetButton" DockPanel.Dock="Left" Content="全部跟随全局" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Content="确定" IsDefault="True" Style="{StaticResource PrimaryButton}" />
            <Button x:Name="CancelButton" DockPanel.Dock="Right" Content="取消" IsCancel="True" Margin="0,0,8,0" />
        </DockPanel>
    </StackPanel>
</Window>
