<Window x:Class="AntoCopy.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCopy"
        Width="880" Height="700" MinWidth="360" MinHeight="260"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="Microsoft YaHei UI" FontSize="12.5"
        Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">
    <DockPanel>
        <!-- 菜单栏 -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Menu Background="Transparent" Foreground="{DynamicResource TextBrush}" Padding="6,2">
                <MenuItem x:Name="FileMenu" Header="文件(_F)">
                    <MenuItem x:Name="SaveMenu" Header="保存设置" InputGestureText="Ctrl+S" />
                    <Separator />
                    <MenuItem x:Name="OpenDestMenu" Header="打开备份目标" />
                    <MenuItem x:Name="OpenLogDirMenu" Header="打开日志目录" />
                    <Separator />
                    <MenuItem x:Name="HideToTrayMenu" Header="隐藏到托盘" />
                    <MenuItem x:Name="ExitMenu" Header="退出 AutoCopy" />
                </MenuItem>
                <MenuItem x:Name="ActionMenu" Header="操作(_A)">
                    <MenuItem x:Name="CopyNowMenu" Header="立即执行定时模式" />
                    <Separator />
                    <MenuItem x:Name="StartCountdownMenu" Header="启动倒计时" />
                    <MenuItem x:Name="StopCountdownMenu" Header="停止倒计时" />
                    <Separator />
                    <MenuItem x:Name="ScreenOffNowMenu" Header="立即息屏"
                              ToolTip="关闭显示器但系统不睡眠，动鼠标/键盘即可点亮" />
                </MenuItem>
                <MenuItem Header="设置(_S)">
                    <MenuItem x:Name="WifiScreenOffMenu" Header="WiFi 断开时自动息屏" IsCheckable="True"
                              ToolTip="已连接的 WiFi 断开约 6 秒后关闭显示器；系统不睡眠，备份照常执行，WiFi 恢复后撤销" />
                    <Separator />
                    <MenuItem x:Name="ThemeSystemMenu" Header="主题跟随系统" />
                    <MenuItem x:Name="ThemeLightMenu" Header="白天模式" />
                    <MenuItem x:Name="ThemeDarkMenu" Header="黑夜模式" />
                </MenuItem>
            </Menu>
        </Border>

        <!-- 顶部栏 -->
        <Border DockPanel.Dock="Top" Height="48" Padding="14,0,12,0"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="AutoCopy" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock x:Name="SubtitleText" Style="{StaticResource Hint}" Margin="10,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="SaveHintText" Foreground="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    <CheckBox x:Name="AutoStartCheck" Content="开机自启" Margin="0,0,12,0" />
                    <Button x:Name="RefreshButton" Content="刷新" Margin="0,0,8,0" />
                    <Button x:Name="SaveButton" Content="保存设置" Style="{StaticResource PrimaryButton}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 备份进度：有备份在跑（或刚结束几秒内）时显示；定时与倒计时同时在跑时各占一行 -->
        <Border x:Name="ProgressStrip" DockPanel.Dock="Top" Visibility="Collapsed" Padding="14,8,14,10"
                Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <ItemsControl x:Name="ProgressSessionList" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,2">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" FontWeight="Bold" />
                                <TextBlock DockPanel.Dock="Right" Text="{Binding PercentText}" FontWeight="Bold" Margin="12,0,0,0" />
                                <TextBlock Text="{Binding Detail}" ToolTip="{Binding Detail}" Style="{StaticResource Hint}" Margin="10,0,0,0" />
                            </DockPanel>
                            <ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="0,6,0,0">
                                <ProgressBar.Style>
                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource UsageBar}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ProgressBar.Style>
                            </ProgressBar>
                            <!-- 每个文件夹一个标签：✓ 已备份、⟳ 正在备份、○ 等待中、✗ 失败、– 未执行 -->
                            <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="0,2,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,2" Margin="0,6,6,0" BorderThickness="1" ToolTip="{Binding ToolTipText}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Active">
                                                            <Setter Property="Background" Value="{DynamicResource SelectBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Done">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                            <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Text}" FontSize="12">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Active">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Done">
                                                                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- 内容区：尺寸由 UpdateContentLayout 按窗口大小设定，比最小尺寸小时出现滚动条 -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
            <Grid x:Name="ContentRoot" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                    <RowDefinition x:Name="LogRow" Height="*" />
                </Grid.RowDefinitions>

                <!-- 统计（UniformGrid 无间距属性：子项右/下留 10，整体用负边距抵消） -->
                <UniformGrid x:Name="TilesGrid" Grid.Row="0" Columns="4" Margin="0,0,-10,-10">
                    <Border Style="{StaticResource Card}" Height="58" Padding="14,7,14,6" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="倒计时" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="CountdownStatusText" Text="—" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Height="58" Padding="14,7,14,6" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="备份占用" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="StorageText" Text="—" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Height="58" Padding="14,7,14,6" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="定时副本" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="ScheduledCopiesText" Text="—" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Height="58" Padding="14,7,14,6" Margin="0,0,10,10">
                        <StackPanel>
                            <TextBlock Text="倒计时副本" Style="{StaticResource Hint}" />
                            <TextBlock x:Name="CountdownCopiesText" Text="—" Style="{StaticResource StatValue}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- 资源占用：系统 CPU / 内存 / 备份目标磁盘，以及本程序（含 7z）的占用；每 2 秒刷新 -->
                <UniformGrid x:Name="ResourceTilesGrid" Grid.Row="2" Columns="4" Margin="0,0,-10,-10">
                    <Border x:Name="CpuTile" Style="{StaticResource Card}" Height="64" Padding="14,7,14,9" Margin="0,0,10,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CPU" Style="{StaticResource Hint}" />
                            <ProgressBar x:Name="CpuBar" DockPanel.Dock="Bottom" Style="{StaticResource UsageBar}" />
                            <TextBlock x:Name="CpuDetailText" DockPanel.Dock="Right" Style="{StaticResource UsageDetail}" />
                            <TextBlock x:Name="CpuText" Text="—" Style="{StaticResource StatValue}" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="MemoryTile" Style="{StaticResource Card}" Height="64" Padding="14,7,14,9" Margin="0,0,10,10">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="内存" Style="{StaticResource Hint}" />
                            <ProgressBar x:Name="MemoryBar" DockPanel.Dock="Bottom" Style="{StaticResource UsageBar}" />
                            <TextBlock x:Name="MemoryDetailText" DockPanel.Dock="Right" Style="{StaticResource UsageDetail}" />
                            <TextBlock x:Name="MemoryText" Text="—" Style="{StaticResource StatValue}" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="DiskTile" Style="{StaticResource Card}" Height="64" Padding="14,7,14,9" Margin="0,0,10,10">
                        <DockPanel>
                            <TextBlock x:Name="DiskTitleText" DockPanel.Dock="Top" Text="存储" Style="{StaticResource Hint}" />
                            <ProgressBar x:Name="DiskBar" DockPanel.Dock="Bottom" Style="{StaticResource UsageBar}" />
                            <TextBlock x:Name="DiskDetailText" DockPanel.Dock="Right" Style="{StaticResource UsageDetail}" />
                            <TextBlock x:Name="DiskText" Text="—" Style="{StaticResource StatValue}" />
                        </DockPanel>
                    </Border>
                    <Border x:Name="AppTile" Style="{StaticResource Card}" Height="64" Padding="14,7,14,9" Margin="0,0,10,10">
                        <DockPanel>
                            <TextBlock x:Name="AppTitleText" DockPanel.Dock="Top" Text="本程序" Style="{StaticResource Hint}" />
                            <ProgressBar x:Name="AppBar" DockPanel.Dock="Bottom" Style="{StaticResource UsageBar}" />
                            <TextBlock x:Name="AppDetailText" DockPanel.Dock="Right" Style="{StaticResource UsageDetail}" />
                            <TextBlock x:Name="AppText" Text="—" Style="{StaticResource StatValue}" />
                        </DockPanel>
                    </Border>
                </UniformGrid>

                <!-- 主体：宽窗口左右两栏，窄窗口上下单列（ApplyLayout 切换） -->
                <Grid x:Name="BodyGrid" Grid.Row="4">
                    <Grid x:Name="LeftColumn">
                        <Grid.RowDefinitions>
                            <RowDefinition x:Name="SourceRow" Height="*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="108" />
                        </Grid.RowDefinitions>

                        <!-- 源文件夹 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="SourceTitleText" Text="源文件夹" Style="{StaticResource CardTitle}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SourceInput" Tag="输入或浏览文件夹路径，回车添加" />
                                    <Button x:Name="SourceBrowseButton" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" />
                                    <Button x:Name="AddSourceButton" Grid.Column="2" Content="添加" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}" />
                                </Grid>
                                <ListBox x:Name="SourceList" Grid.Row="2" Margin="0,6" AllowDrop="True"
                                         Background="{DynamicResource CardBrush}" Foreground="{DynamicResource TextBrush}"
                                         BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ItemContainerStyle="{StaticResource SourceItemStyle}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem x:Name="SourceRuleMenu" Header="备份频率…" />
                                            <MenuItem x:Name="OpenSourceMenu" Header="打开文件夹" />
                                            <Separator />
                                            <MenuItem x:Name="RemoveSourceMenu" Header="删除" InputGestureText="Del" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Background="Transparent" ToolTip="{Binding ToolTipText}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- 单独设置了频率的文件夹显示简述 -->
                                                <TextBlock Grid.Column="1" Text="{Binding RuleText}" FontSize="12" Margin="12,0,0,0"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <!-- 路径不存在标红；从未备份过的摘要用警示色 -->
                                                <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMissing}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <!-- 备份进行中显示该文件夹的进度（等待 / 压缩 45% / 已完成…），否则显示上次备份摘要 -->
                                                <TextBlock Grid.Column="2" Text="{Binding DisplaySummary}" FontSize="12" Margin="12,0,0,0">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeverBackedUp}" Value="True">
                                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProgressStatus}" Value="Pending">
                                                                    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProgressStatus}" Value="Active">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProgressStatus}" Value="Done">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding ProgressStatus}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <Button x:Name="RemoveSourceButton" Content="删除选中" Style="{StaticResource DangerButton}" Margin="0,0,8,0" />
                                    <Button x:Name="ClearSourcesButton" Content="清空全部" Margin="0,0,8,0" />
                                    <Button x:Name="OpenSourceButton" Content="打开所选" Margin="0,0,8,0" />
                                    <Button x:Name="SourceRuleButton" Content="备份频率" />
                                </StackPanel>
                                <TextBlock Grid.Row="4" Text="可直接拖入文件夹；双击可单独设置该文件夹的备份频率" Style="{StaticResource Hint}" />
                            </Grid>
                        </Border>

                        <!-- 备份目标 -->
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="22" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="备份目标" Style="{StaticResource CardTitle}" />
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="DestInput" Tag="备份输出的根目录，例如 D:\Backup" />
                                    <Button x:Name="DestBrowseButton" Grid.Column="1" Content="浏览…" Margin="8,0,0,0" />
                                    <Button x:Name="OpenDestButton" Grid.Column="2" Content="打开" Margin="8,0,0,0" />
                                </Grid>
                                <TextBlock Grid.Row="2" Text="存放于：目标 \ 模式子目录 \ 时间戳 \ *.7z" Style="{StaticResource Hint}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid x:Name="RightColumn">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="156" />
                            <RowDefinition Height="10" />
                            <RowDefinition x:Name="CountdownRow" Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 定时模式 -->
                        <Border Grid.Row="0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="定时模式" Style="{StaticResource CardTitle}" />
                                <Button x:Name="CopyNowButton" Content="立即执行" HorizontalAlignment="Right" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="每日时间" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="RunTimeInput" Width="90" Tag="02:00" />
                                    <TextBlock Text="HH:mm，留空则不定时" Style="{StaticResource Hint}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="子目录" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScheduledFolderInput" Width="170" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Text="保留份数" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="ScheduledKeepInput" Width="90" />
                                    <TextBlock Text="0 = 不限，每个文件夹各自保留" Style="{StaticResource Hint}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 倒计时模式 -->
                        <Border Grid.Row="2" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="30" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="32" />
                                    <RowDefinition Height="28" />
                                    <RowDefinition Height="34" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="倒计时模式" Style="{StaticResource CardTitle}" />
                                <StackPanel Grid.Row="1" Orientation="Horizontal">
                                    <TextBlock Text="间隔秒数" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CountdownSecondsInput" Width="90" />
                                    <TextBlock x:Name="CountdownDurationText" Style="{StaticResource Hint}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="2" Orientation="Horizontal">
                                    <TextBlock Text="子目录" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CountdownFolderInput" Width="170" />
                                </StackPanel>
                                <StackPanel Grid.Row="3" Orientation="Horizontal">
                                    <TextBlock Text="保留份数" Style="{StaticResource FieldLabel}" />
                                    <TextBox x:Name="CountdownKeepInput" Width="90" />
                                    <TextBlock Text="0 = 不限，每个文件夹各自保留" Style="{StaticResource Hint}" Margin="10,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="4" Orientation="Horizontal">
                                    <CheckBox x:Name="SkipWindowCheck" VerticalAlignment="Center" />
                                    <TextBox x:Name="SkipStartInput" Width="60" Tag="00:00" />
                                    <TextBlock Text="–" Style="{StaticResource Hint}" Margin="6,0" />
                                    <TextBox x:Name="SkipEndInput" Width="60" Tag="07:59" />
                                    <TextBlock Text="期间跳过执行" Style="{StaticResource Hint}" Margin="8,0,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Bottom">
                                    <Button x:Name="StartCountdownButton" Content="启动倒计时" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" />
                                    <Button x:Name="StopCountdownButton" Content="停止" Style="{StaticResource DangerButton}" />
                                    <TextBlock Text="开机不会自动开启倒计时" Style="{StaticResource Hint}" Margin="12,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- 执行日志 -->
                <Border Grid.Row="6" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="执行日志" Style="{StaticResource CardTitle}" />
                        <Button x:Name="ClearLogButton" Content="清空" HorizontalAlignment="Right" />
                        <Border Grid.Row="1" Background="{DynamicResource LogBgBrush}" BorderBrush="{DynamicResource LogBorderBrush}"
                                BorderThickness="1" CornerRadius="5" Padding="10,8,4,8">
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                     Foreground="{DynamicResource LogTextBrush}" SelectionMode="Extended"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                     ItemContainerStyle="{StaticResource LogItemStyle}">
                                <ListBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem x:Name="CopySelectedLogMenu" Header="复制选中" InputGestureText="Ctrl+C" />
                                        <MenuItem x:Name="CopyAllLogMenu" Header="复制全部" />
                                    </ContextMenu>
                                </ListBox.ContextMenu>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap">
                                            <Run Text="{Binding Time, Mode=OneTime}" Foreground="{DynamicResource LogTimeBrush}" /><Run Text="{Binding Message, Mode=OneTime}" Style="{StaticResource LogMessageRun}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
